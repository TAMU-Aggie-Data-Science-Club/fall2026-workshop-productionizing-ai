# Local-first image. The Llama weights live in the Ollama service volume, not
# in this image, so application rebuilds are fast and do not duplicate several
# gigabytes of model data.
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/huggingface \
    TRANSFORMERS_CACHE=/opt/huggingface/hub

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Retrieval still uses the small MiniLM embedder. Bake that artifact into the
# app image so neither retrieval nor LLM inference downloads weights at runtime.
RUN NIMBUS_ALLOW_MODEL_DOWNLOAD=1 python data/build_index.py

RUN addgroup --system nimbus \
    && adduser --system --ingroup nimbus nimbus \
    && chown -R nimbus:nimbus /app /opt/huggingface

USER nimbus

ENV NIMBUS_ALLOW_MODEL_DOWNLOAD=0 \
    NIMBUS_MODEL_BACKEND=ollama \
    PORT=8000

EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn app:app --app-dir service --host 0.0.0.0 --port ${PORT:-8000}"]
